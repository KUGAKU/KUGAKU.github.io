---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { languages, type Lang } from "../i18n/ui";
import { getLangFromUrl, pick, localizePath } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
}

const lang: Lang = getLangFromUrl(Astro.url);
const { title, description } = Astro.props;

const siteTitle = pick(site.title, lang);
const siteDescription = pick(site.description, lang);

const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const pageDescription = description ?? siteDescription;
const currentPath = Astro.url.pathname;

const htmlLang = lang === "ja" ? "ja" : "en";
const ogLocale = lang === "ja" ? "ja_JP" : "en_US";

// hreflang alternates — build absolute URLs for SEO
const siteOrigin = Astro.site?.origin ?? "https://kugaku.github.io";
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  lang: l,
  href: siteOrigin + localizePath(currentPath, l),
}));
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <!-- Google Analytics (GA4) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-N2VWS7TMX7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-N2VWS7TMX7');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />

    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.lang} href={alt.href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={siteOrigin + localizePath(currentPath, "ja")}
    />

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
      crossorigin="anonymous"
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho:wght@500;600;700&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <!-- Paint-safe theme init: set data-theme BEFORE first paint to avoid FOUC -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored ||
            (window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>

    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {lang === "ja" ? "本文へスキップ" : "Skip to main content"}
    </a>
    <Header currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
