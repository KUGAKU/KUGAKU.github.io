---
// BitRain.astro
// Matrix-style 01 binary rain as a subtle hero background.
// - Reads --color-primary / --color-bg from the current theme
// - Re-reads colors on [data-theme] mutation (light/dark toggle)
// - Pauses when off-screen (IntersectionObserver) or tab hidden
// - Respects prefers-reduced-motion (static snapshot, no animation)
// - Self-cleans on pagehide to drop RAF and observers
---

<canvas class="bit-rain" data-bit-rain aria-hidden="true"></canvas>

<script is:inline>
  (function () {
    var canvases = document.querySelectorAll("[data-bit-rain]");
    if (!canvases.length) return;

    canvases.forEach(function (canvas) {
      if (canvas.dataset.bound === "1") return;
      canvas.dataset.bound = "1";

      var ctx = canvas.getContext("2d");
      if (!ctx) return;

      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var width = 0;
      var height = 0;
      var fontSize = 16;
      var cols = 0;
      var drops = [];
      var speeds = [];
      var visible = true;
      var running = true;
      var rafId = 0;
      var lastFrame = 0;
      var frameInterval = 65; // ~15 fps — decorative, cheap
      var primaryRgb = "27, 58, 107";
      var bgRgb = "243, 245, 249";

      function hexToRgb(raw) {
        var hex = String(raw || "").trim().replace("#", "");
        if (hex.length === 3) {
          hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
        }
        if (hex.length !== 6) return null;
        var n = parseInt(hex, 16);
        if (isNaN(n)) return null;
        return (
          ((n >> 16) & 255) + ", " + ((n >> 8) & 255) + ", " + (n & 255)
        );
      }

      function readThemeColors() {
        var cs = getComputedStyle(document.documentElement);
        var p = hexToRgb(cs.getPropertyValue("--color-primary"));
        var b = hexToRgb(cs.getPropertyValue("--color-surface"));
        if (p) primaryRgb = p;
        if (b) bgRgb = b;
      }

      function resize() {
        var rect = canvas.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        if (width <= 0 || height <= 0) return;
        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.scale(dpr, dpr);
        cols = Math.max(1, Math.floor(width / fontSize));
        drops = new Array(cols);
        speeds = new Array(cols);
        for (var i = 0; i < cols; i++) {
          drops[i] = Math.random() * -height;
          speeds[i] = fontSize * (0.55 + Math.random() * 0.7);
        }
      }

      function draw(time) {
        rafId = requestAnimationFrame(draw);
        if (!running || !visible) return;
        if (time - lastFrame < frameInterval) return;
        lastFrame = time;

        // Background trail fade (long trails)
        ctx.fillStyle = "rgba(" + bgRgb + ", 0.11)";
        ctx.fillRect(0, 0, width, height);

        // Bits
        ctx.font =
          fontSize +
          "px 'JetBrains Mono', 'SFMono-Regular', Consolas, Menlo, monospace";
        ctx.fillStyle = "rgba(" + primaryRgb + ", 0.58)";

        for (var i = 0; i < cols; i++) {
          var bit = Math.random() > 0.5 ? "1" : "0";
          ctx.fillText(bit, i * fontSize, drops[i]);
          if (drops[i] > height && Math.random() > 0.975) {
            drops[i] = Math.random() * -fontSize * 4;
          }
          drops[i] += speeds[i];
        }
      }

      function drawStatic() {
        ctx.clearRect(0, 0, width, height);
        ctx.font =
          fontSize +
          "px 'JetBrains Mono', 'SFMono-Regular', Consolas, Menlo, monospace";
        ctx.fillStyle = "rgba(" + primaryRgb + ", 0.2)";
        for (var y = fontSize; y < height; y += fontSize) {
          for (var x = 0; x < width; x += fontSize) {
            ctx.fillText(Math.random() > 0.5 ? "1" : "0", x, y);
          }
        }
      }

      // Visibility observer — pause when hero scrolls off screen
      var io = null;
      if ("IntersectionObserver" in window) {
        io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            visible = e.isIntersecting;
          });
        });
        io.observe(canvas);
      }

      // Theme mutation observer — re-read colors on light/dark toggle
      var mo = new MutationObserver(function () {
        readThemeColors();
      });
      mo.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });

      // Debounced resize
      var resizeTimer = 0;
      function onResize() {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(resize, 150);
      }
      window.addEventListener("resize", onResize);

      // Pause on tab hidden
      function onVisibility() {
        if (document.hidden) {
          running = false;
        } else {
          running = true;
          lastFrame = 0;
        }
      }
      document.addEventListener("visibilitychange", onVisibility);

      // Cleanup on pagehide
      function cleanup() {
        cancelAnimationFrame(rafId);
        window.removeEventListener("resize", onResize);
        document.removeEventListener("visibilitychange", onVisibility);
        if (io) io.disconnect();
        mo.disconnect();
      }
      window.addEventListener("pagehide", cleanup, { once: true });

      // Init
      readThemeColors();
      resize();

      var prefersReduced =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (prefersReduced) {
        drawStatic();
      } else {
        rafId = requestAnimationFrame(draw);
      }
    });
  })();
</script>

<style>
  .bit-rain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 0.9;

    /* Soft radial mask so the rain fades near the edges */
    -webkit-mask-image: radial-gradient(
      ellipse 85% 90% at 70% 50%,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.85) 45%,
      rgba(0, 0, 0, 0) 95%
    );
    mask-image: radial-gradient(
      ellipse 85% 90% at 70% 50%,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.85) 45%,
      rgba(0, 0, 0, 0) 95%
    );
  }

  [data-theme="dark"] .bit-rain {
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .bit-rain {
      opacity: 0.35;
    }
  }
</style>
