---
import { languages, type Lang } from "../i18n/ui";
import { getLangFromUrl, useTranslations, localizePath } from "../i18n/utils";

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const currentPath = Astro.url.pathname;

const entries = Object.keys(languages) as Lang[];
---

<div class="lang-switcher" role="group" aria-label={t("lang.switch")}>
  {
    entries.map((lang, i) => (
      <>
        {i > 0 && <span class="lang-switcher__sep" aria-hidden="true">/</span>}
        <a
          href={localizePath(currentPath, lang)}
          class:list={[
            "lang-switcher__item",
            { "is-active": currentLang === lang },
          ]}
          hreflang={lang}
          lang={lang}
          aria-current={currentLang === lang ? "page" : undefined}
        >
          {lang.toUpperCase()}
        </a>
      </>
    ))
  }
</div>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
  }

  .lang-switcher__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    min-height: 40px;
    padding: 0 0.35rem;
    color: var(--color-text-secondary);
    border-bottom: 1px solid transparent;
    text-decoration: none;
    transition:
      color var(--dur-base) var(--ease),
      border-color var(--dur-base) var(--ease);
  }
  .lang-switcher__item:hover,
  .lang-switcher__item:focus-visible {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }
  .lang-switcher__item.is-active {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .lang-switcher__sep {
    color: var(--color-border-strong);
    user-select: none;
  }
</style>
