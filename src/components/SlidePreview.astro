---
interface SlideItem {
  src: string;
  alt?: string;
}

interface Props {
  slides: (string | SlideItem)[];
  /** Slides at index >= lockAfter are blurred and overlaid with a gate. */
  lockAfter?: number;
  /** Heading shown above the viewer. Optional. */
  title?: string;
  /** Aspect ratio of the slide stage, e.g. "16/9". */
  aspect?: string;
}

const {
  slides,
  lockAfter,
  title,
  aspect = "16/9",
} = Astro.props;

const items: SlideItem[] = slides.map((s) =>
  typeof s === "string" ? { src: s } : s,
);
const total = items.length;
const lockIndex = lockAfter ?? total; // by default nothing is locked
---

<figure
  class="slide-preview"
  data-slide-preview
  data-total={total}
  data-lock-after={lockIndex}
  style={`--aspect: ${aspect};`}
>
  {title && <figcaption class="slide-preview__title">{title}</figcaption>}

  <div class="slide-preview__stage">
    <div class="slide-preview__track" data-track>
      {
        items.map((item, i) => (
          <div
            class:list={[
              "slide-preview__slide",
              i >= lockIndex && "is-locked",
            ]}
            data-index={i}
            data-current={i === 0 ? "true" : "false"}
            aria-hidden={i === 0 ? "false" : "true"}
          >
            <img
              src={item.src}
              alt={item.alt ?? `Slide ${i + 1}`}
              loading={i === 0 ? "eager" : "lazy"}
              draggable="false"
            />
            {i >= lockIndex && (
              <div class="slide-preview__gate" aria-hidden="true">
                <div class="slide-preview__gate-inner">
                  <p class="slide-preview__gate-label">Preview ends here</p>
                  <p class="slide-preview__gate-hint">
                    {"続きは準備中 — 後日ダウンロード公開予定"}
                  </p>
                </div>
              </div>
            )}
          </div>
        ))
      }
    </div>

    <button
      type="button"
      class="slide-preview__nav slide-preview__nav--prev"
      data-prev
      aria-label="前のスライド"
    >
      ‹
    </button>
    <button
      type="button"
      class="slide-preview__nav slide-preview__nav--next"
      data-next
      aria-label="次のスライド"
    >
      ›
    </button>
  </div>

  <div class="slide-preview__bar">
    <span class="slide-preview__counter">
      <span data-counter>1</span> / {total}
    </span>
    <ol class="slide-preview__dots" role="tablist">
      {
        items.map((_, i) => (
          <li>
            <button
              type="button"
              class:list={[
                "slide-preview__dot",
                i >= lockIndex && "is-locked",
              ]}
              data-dot={i}
              data-current={i === 0 ? "true" : "false"}
              aria-label={`スライド ${i + 1} へ`}
            />
          </li>
        ))
      }
    </ol>
  </div>
</figure>

<script is:inline>
  (function () {
    function setup(root) {
      var slides = root.querySelectorAll(".slide-preview__slide");
      var total = slides.length;
      if (total === 0) return;

      var prevBtn = root.querySelector("[data-prev]");
      var nextBtn = root.querySelector("[data-next]");
      var counter = root.querySelector("[data-counter]");
      var dots = root.querySelectorAll("[data-dot]");

      var current = 0;

      function go(next) {
        var clamped = Math.max(0, Math.min(total - 1, next));
        current = clamped;
        for (var i = 0; i < slides.length; i++) {
          var active = i === clamped;
          slides[i].setAttribute("aria-hidden", active ? "false" : "true");
          slides[i].setAttribute("data-current", active ? "true" : "false");
        }
        for (var j = 0; j < dots.length; j++) {
          dots[j].setAttribute(
            "data-current",
            j === clamped ? "true" : "false"
          );
        }
        if (counter) counter.textContent = String(clamped + 1);
        if (prevBtn) prevBtn.disabled = clamped === 0;
        if (nextBtn) nextBtn.disabled = clamped === total - 1;
      }

      if (prevBtn) prevBtn.addEventListener("click", function () { go(current - 1); });
      if (nextBtn) nextBtn.addEventListener("click", function () { go(current + 1); });
      dots.forEach(function (d) {
        d.addEventListener("click", function () {
          go(Number(d.getAttribute("data-dot") || 0));
        });
      });

      root.tabIndex = 0;
      root.addEventListener("keydown", function (e) {
        if (e.key === "ArrowLeft") { e.preventDefault(); go(current - 1); }
        else if (e.key === "ArrowRight") { e.preventDefault(); go(current + 1); }
      });

      go(0);
    }

    function init() {
      document.querySelectorAll("[data-slide-preview]").forEach(setup);
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>

