---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../data/profile";
import { notes } from "../../data/notes";
import { getLangFromUrl, useTranslations, pick, localizePath } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const latestNotes = notes.slice(0, 3);
const greeting = pick(profile.greeting, lang);
const bio = pick(profile.bio, lang);
const hasGreeting = greeting.length > 0;
const hasBio = bio.length > 0;
const hasInterests = profile.interests.length > 0;
const hasNotes = latestNotes.length > 0;
---

<BaseLayout>
  <!-- ================= Hero ================= -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="hero__eyebrow" aria-hidden="true">{t("home.eyebrow")}</p>
        <h1 class="hero__title">
          <span class="hero__title-main">
            {lang === "ja" ? "苦学 Lab" : "Kugaku Lab"}
          </span>
        </h1>

        {hasGreeting && <p class="hero__greeting">{greeting}</p>}
        {hasBio && <p class="hero__bio">{bio}</p>}

        {
          !hasBio && !hasGreeting && (
            <p class="hero__bio hero__bio--placeholder">
              {t("home.bioPlaceholder")}
            </p>
          )
        }

        <div class="hero__actions">
          <a href={localizePath("/about/", lang)} class="btn btn--primary">
            {t("home.cta.about")}
          </a>
          <a href={localizePath("/notes/", lang)} class="btn btn--ghost">
            {t("home.cta.notes")}
          </a>
        </div>
      </div>

      <aside class="hero__seal" aria-hidden="true">
        <div class="seal">
          <span class="seal__char">苦</span>
        </div>
      </aside>
    </div>
  </section>

  <!-- ================= Interests ================= -->
  {
    hasInterests && (
      <section class="section">
        <div class="container">
          <div class="section__head">
            <h2 class="section__title">{t("home.interests.title")}</h2>
            <span class="section__rule" aria-hidden="true" />
            <span class="section__kicker">{t("home.interests.kicker")}</span>
          </div>
          <ul class="interest-grid">
            {profile.interests.map((item) => (
              <li class="interest-card">
                <span class="interest-card__main">
                  {lang === "ja" ? item.ja : item.en || item.ja}
                </span>
                <span class="interest-card__sub">
                  {lang === "ja" ? item.en : item.ja}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ================= Latest Notes ================= -->
  <section class="section section--surface">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">{t("home.latest.title")}</h2>
        <span class="section__rule" aria-hidden="true"></span>
        <span class="section__kicker">{t("home.latest.kicker")}</span>
      </div>

      {
        hasNotes ? (
          <ul class="note-list">
            {latestNotes.map((n) => (
              <li class="note-item">
                <a
                  href={n.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="note-item__link"
                >
                  <time class="note-item__date">{n.date}</time>
                  <span class="note-item__title">{pick(n.title, lang)}</span>
                  <span class="note-item__arrow" aria-hidden="true">
                    →
                  </span>
                </a>
                {pick(n.excerpt, lang) && (
                  <p class="note-item__excerpt">{pick(n.excerpt, lang)}</p>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">{t("home.latest.empty")}</p>
        )
      }

      {
        hasNotes && (
          <div class="section__more">
            <a href={localizePath("/notes/", lang)}>{t("home.latest.more")}</a>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* ========== Hero ========== */
  .hero {
    position: relative;
    padding-block: clamp(var(--space-2xl), 4vw + 1rem, var(--space-3xl));
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 85% 20%,
        color-mix(in srgb, var(--color-primary) 8%, transparent) 0%,
        transparent 40%
      ),
      radial-gradient(
        circle at 10% 80%,
        color-mix(in srgb, var(--color-text) 5%, transparent) 0%,
        transparent 45%
      );
    pointer-events: none;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2xl);
    align-items: center;
    position: relative;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    color: var(--color-primary);
    text-transform: uppercase;
    margin: 0 0 var(--space-md);
  }

  .hero__title {
    font-family: var(--font-serif-jp);
    font-size: clamp(2.25rem, 1.5rem + 3.2vw, 4.25rem);
    line-height: 1.1;
    letter-spacing: 0.14em;
    font-weight: 700;
    margin: 0 0 var(--space-lg);
  }

  .hero__title-main {
    display: inline-block;
    border-left: 4px solid var(--color-primary);
    padding-left: var(--space-lg);
  }

  .hero__greeting {
    font-family: var(--font-serif-jp);
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    color: var(--color-text);
    margin: 0 0 var(--space-lg);
  }

  .hero__bio {
    max-width: 38em;
    margin: 0 0 var(--space-xl);
    color: var(--color-text);
  }
  .hero__bio--placeholder {
    color: var(--color-text-secondary);
    font-family: var(--font-serif-jp);
    letter-spacing: 0.08em;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  /* 落款風シール */
  .seal {
    width: clamp(6.5rem, 10vw, 9rem);
    height: clamp(6.5rem, 10vw, 9rem);
    background: var(--color-primary);
    color: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    box-shadow:
      inset 0 0 0 4px var(--color-primary),
      inset 0 0 0 6px var(--color-surface),
      inset 0 0 0 8px var(--color-primary),
      var(--shadow-2);
    transform: rotate(-4deg);
    position: relative;
  }

  .seal__char {
    font-family: var(--font-serif-jp);
    font-size: clamp(3.5rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
  }

  /* ========== Buttons ========== */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85em 1.6em;
    min-height: 44px;
    font-family: var(--font-serif-jp);
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      background-color var(--dur-base) var(--ease),
      color var(--dur-base) var(--ease),
      border-color var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
    text-decoration: none;
  }

  .btn--primary {
    background: var(--color-primary);
    color: var(--color-surface);
    border-color: var(--color-primary);
  }

  .btn--primary:hover,
  .btn--primary:focus-visible {
    background: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
    color: var(--color-surface);
    transform: translateY(-1px);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* ========== Sections ========== */
  .section {
    padding-block: var(--space-2xl);
  }

  .section--surface {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .section__head {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
    flex-wrap: wrap;
  }

  .section__title {
    font-family: var(--font-serif-jp);
    font-size: clamp(1.25rem, 0.9rem + 1vw, 1.6rem);
    letter-spacing: 0.12em;
    margin: 0;
  }

  .section__rule {
    flex: 1 1 auto;
    height: 1px;
    background: var(--color-border-strong);
    max-width: 12rem;
    min-width: 2rem;
  }

  .section__kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: var(--color-text-secondary);
    text-transform: uppercase;
  }

  .section__more {
    margin-top: var(--space-xl);
    text-align: right;
    font-family: var(--font-serif-jp);
    letter-spacing: 0.08em;
  }

  /* ========== Interests ========== */
  .interest-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }

  .interest-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-lg);
    border-radius: var(--radius-sm);
    position: relative;
    transition:
      border-color var(--dur-base) var(--ease),
      box-shadow var(--dur-base) var(--ease);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .interest-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: var(--color-primary);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease);
  }

  .interest-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-1);
  }
  .interest-card:hover::before {
    opacity: 1;
  }

  .interest-card__main {
    font-family: var(--font-serif-jp);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-text);
  }

  .interest-card__sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--color-text-secondary);
    text-transform: uppercase;
  }

  /* ========== Notes list ========== */
  .note-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .note-item {
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .note-item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .note-item__link {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: var(--space-md);
    align-items: baseline;
    color: var(--color-text);
    border-bottom: none;
    padding: 0;
  }

  .note-item__date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
  }

  .note-item__title {
    font-family: var(--font-serif-jp);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    transition: color var(--dur-base) var(--ease);
  }

  .note-item__link:hover .note-item__title,
  .note-item__link:focus-visible .note-item__title {
    color: var(--color-primary);
  }

  .note-item__arrow {
    font-family: var(--font-serif-jp);
    color: var(--color-text-secondary);
    transition:
      transform var(--dur-base) var(--ease),
      color var(--dur-base) var(--ease);
  }

  .note-item__link:hover .note-item__arrow {
    color: var(--color-primary);
    transform: translateX(4px);
  }

  .note-item__excerpt {
    margin: var(--space-sm) 0 0 calc(7rem + var(--space-md));
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .empty {
    text-align: center;
    color: var(--color-text-secondary);
    padding: var(--space-xl) 0;
    font-family: var(--font-serif-jp);
    letter-spacing: 0.08em;
  }

  /* ========== Responsive ========== */
  @media (max-width: 900px) {
    .hero__inner {
      gap: var(--space-xl);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-block: var(--space-2xl);
    }
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .hero__seal {
      justify-self: flex-start;
      order: -1;
    }
    .seal {
      width: 6.5rem;
      height: 6.5rem;
    }
    .seal__char {
      font-size: 3.6rem;
    }
    .hero__title-main {
      padding-left: var(--space-md);
    }
  }

  @media (max-width: 560px) {
    .note-item__link {
      grid-template-columns: 1fr auto;
    }
    .note-item__date {
      grid-column: 1 / -1;
      margin-bottom: var(--space-xs);
    }
    .note-item__excerpt {
      margin-left: 0;
    }
    .btn {
      flex: 1 1 auto;
    }
  }

  @media (max-width: 420px) {
    .hero__actions {
      gap: var(--space-sm);
    }
    .seal {
      width: 5.5rem;
      height: 5.5rem;
    }
    .seal__char {
      font-size: 3rem;
    }
  }
</style>
