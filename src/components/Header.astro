---
import { site } from "../data/site";
import { getLangFromUrl, useTranslations, pick, localizePath } from "../i18n/utils";
import ThemeToggle from "./ThemeToggle.astro";
import LangSwitcher from "./LangSwitcher.astro";
import BrandMark from "./BrandMark.astro";

interface Props {
  currentPath?: string;
}
const { currentPath = "/" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherLang = lang === "ja" ? "en" : "ja";

const siteTitle = pick(site.title, lang);
const siteTagline = pick(site.tagline, lang);

// Sub-label (kicker) shows the OPPOSITE language for visual character
const navKickers = {
  "nav.home": { ja: "ホーム", en: "Home" },
  "nav.about": { ja: "プロフィール", en: "About" },
  "nav.notes": { ja: "ノート", en: "Notes" },
} as const;

// Normalize path for matching the active nav item (ignore /en prefix and trailing slash)
const stripLocale = (p: string) => {
  let s = p;
  if (s === "/en" || s.startsWith("/en/")) s = s.slice(3) || "/";
  s = s.replace(/\/+$/, "");
  return s === "" ? "/" : s;
};
const current = stripLocale(currentPath);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a
      href={localizePath("/", lang)}
      class="brand"
      aria-label={`${siteTitle} ${lang === "ja" ? "トップへ" : "Home"}`}
    >
      <BrandMark class="brand__mark" />
      <span class="brand__text">
        <span class="brand__title">{siteTitle}</span>
        {siteTagline && <span class="brand__tagline">{siteTagline}</span>}
      </span>
    </a>

    <div class="site-header__actions">
      <nav class="site-nav" aria-label={lang === "ja" ? "グローバルナビゲーション" : "Global navigation"}>
        <ul class="site-nav__list">
          {
            site.nav.map((item) => {
              const isCurrent = stripLocale(item.href) === current;
              return (
                <li class="site-nav__item">
                  <a
                    href={localizePath(item.href, lang)}
                    class={`site-nav__link${isCurrent ? " is-current" : ""}`}
                    aria-current={isCurrent ? "page" : undefined}
                  >
                    <span class="site-nav__main">{t(item.key)}</span>
                    <span class="site-nav__sub">
                      {navKickers[item.key][otherLang]}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="site-header__tools">
        <LangSwitcher />
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }

  /* 藍線: subtle indigo accent rule at the bottom */
  .site-header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(
      to right,
      transparent 0%,
      var(--color-primary) 12%,
      var(--color-primary) 88%,
      transparent 100%
    );
    opacity: 0.4;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    color: var(--color-text);
    border-bottom: none;
    min-width: 0;
  }
  .brand:hover {
    color: var(--color-text);
  }

  .brand__mark {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.35rem;
    background: var(--color-primary);
    color: var(--color-surface);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-1);
    flex-shrink: 0;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }

  .brand__title {
    font-family: var(--font-serif-jp);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .brand__tagline {
    font-size: 0.72rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.16em;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .site-nav__list {
    display: flex;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
  }

  .site-nav__link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: var(--space-sm) var(--space-xs);
    color: var(--color-text);
    font-family: var(--font-serif-jp);
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    border-bottom: 1px solid transparent;
    line-height: 1.2;
    min-height: 44px;
    justify-content: center;
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .site-nav__link.is-current {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .site-nav__sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .site-nav__link.is-current .site-nav__sub {
    color: var(--color-primary);
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 960px) {
    .site-header__inner {
      gap: var(--space-md);
    }
    .site-nav__list {
      gap: var(--space-md);
    }
    .site-header__actions {
      gap: var(--space-md);
    }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 720px) {
    .site-header__inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-md);
      padding-block: var(--space-md);
    }
    .site-header__actions {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      gap: var(--space-md);
      padding-top: var(--space-sm);
      border-top: 1px dashed var(--color-border);
    }
    .brand {
      gap: var(--space-sm);
    }
    .brand__mark {
      width: 2.25rem;
      height: 2.25rem;
      padding: 0.3rem;
    }
    .brand__title {
      font-size: 1.05rem;
    }
    .brand__tagline {
      font-size: 0.66rem;
    }
    .site-nav__list {
      gap: var(--space-sm);
    }
    .site-nav__link {
      padding-inline: var(--space-sm);
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .brand__tagline {
      display: none;
    }
    .site-header__actions {
      flex-wrap: wrap;
    }
    .site-nav__list {
      gap: var(--space-xs);
    }
    .site-nav__link {
      font-size: 0.82rem;
      padding-inline: var(--space-xs);
    }
    .site-nav__sub {
      display: none;
    }
  }
</style>
