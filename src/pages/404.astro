---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandCharacter from "../components/BrandCharacter.astro";
---

<BaseLayout title="404 — Not Found">
  <div class="not-found">
    <div class="not-found__character">
      <BrandCharacter mood="crying" />
    </div>
    <h1 class="not-found__title">404</h1>
    <p class="not-found__message">ページが見つかりませんでした</p>
    <a href="/" class="not-found__link">トップに戻る</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: var(--space-xl) var(--container-pad);
    text-align: center;
    color: var(--color-text);
  }

  .not-found__character {
    width: clamp(7rem, 14vw, 15rem);
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .not-found__character > :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .not-found__title {
    font-family: var(--font-serif-jp);
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 700;
    line-height: 1;
    margin: 0 0 var(--space-sm);
  }

  .not-found__message {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-lg);
  }

  .not-found__link {
    font-family: var(--font-serif-jp);
    font-size: 0.95rem;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .not-found__link:hover {
    color: var(--color-primary-dark);
  }
</style>
