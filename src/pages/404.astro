---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandMark from "../components/BrandMark.astro";
---

<BaseLayout title="404 — Not Found">
  <div class="not-found">
    <div class="not-found__icon">
      <div class="seal seal--crying">
        <BrandMark class="seal__mark" />
      </div>
      <!-- tears -->
      <div class="tear tear--left"></div>
      <div class="tear tear--right"></div>
    </div>
    <h1 class="not-found__title">404</h1>
    <p class="not-found__message">ページが見つかりませんでした</p>
    <a href="/" class="not-found__link">トップに戻る</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: var(--space-6) var(--space-4);
    text-align: center;
  }

  .not-found__icon {
    position: relative;
    margin-bottom: var(--space-5);
  }

  .seal {
    width: 7rem;
    height: 7rem;
    padding: 0.9rem;
    background: var(--color-primary);
    color: var(--color-surface);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-2);
    animation: sob 2s ease-in-out infinite;
  }

  .seal__mark {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* sobbing: gentle vertical shake */
  @keyframes sob {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    15% {
      transform: translateY(-3px) rotate(-1.5deg);
    }
    30% {
      transform: translateY(0) rotate(0deg);
    }
    45% {
      transform: translateY(-2px) rotate(1deg);
    }
    60% {
      transform: translateY(0) rotate(0deg);
    }
  }

  /* tears */
  .tear {
    position: absolute;
    width: 6px;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    background: var(--color-primary);
    opacity: 0.5;
    animation: fall 1.8s ease-in infinite;
  }

  .tear--left {
    left: 1.6rem;
    top: 5rem;
    height: 10px;
    animation-delay: 0s;
  }

  .tear--right {
    right: 1.6rem;
    top: 5rem;
    height: 10px;
    animation-delay: 0.7s;
  }

  @keyframes fall {
    0% {
      opacity: 0;
      transform: translateY(0) scaleY(1);
    }
    20% {
      opacity: 0.6;
    }
    100% {
      opacity: 0;
      transform: translateY(28px) scaleY(1.4);
    }
  }

  .not-found__title {
    font-family: var(--font-serif-jp);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
    margin: 0 0 var(--space-2);
  }

  .not-found__message {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-5);
  }

  .not-found__link {
    font-family: var(--font-serif-jp);
    font-size: 0.95rem;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .not-found__link:hover {
    color: var(--color-primary-dark);
  }
</style>
